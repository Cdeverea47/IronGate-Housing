PORT=4000
JWT_SECRET=change_this_to_a_long_random_string

# Stripe (for online rent payments) — see README "Set up Stripe" section
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Where tenants land after paying — your frontend dev server URL locally,
# or your real domain in production.
PUBLIC_APP_URL=http://localhost:5173

# Resend (for email notifications) — see README "Set up email notifications"
# section. Leave unset to disable email sending (in-app notifications still work).
RESEND_API_KEY=re_...
EMAIL_FROM=IronGate Housing <onboarding@resend.dev>
